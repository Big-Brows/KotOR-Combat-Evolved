#include <windows.h>
1 VERSIONINFO
 FILEVERSION 0,0,0,0
 PRODUCTVERSION 0,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "KotOR:CE Launcher\0"
            VALUE "InternalName", "KotOR-CE\0"
            VALUE "OriginalFilename", "KotOR-CE.exe\0"
            VALUE "ProductName", "KotOR:CE\0"
            VALUE "FileVersion", "Development\0"
            VALUE "ProductVersion", "Development\0"
            VALUE "LegalCopyright", "See bundled licenses and upstream credits\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
